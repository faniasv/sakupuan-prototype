# ------------------------------------------------------------------
# SAKUPUAN environment variables.
# Copy to .env.local for development. On Vercel set them in
# Project Settings -> Environment Variables.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ------------------------------------------------------------------

# --- App ---------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# true  = every request without a session cookie acts as the demo user
#         (lets you open /dashboard directly while building the UI).
# false = real login required. MUST be false in production.
DEMO_MODE=true

# --- Auth --------------------------------------------------------
# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- Database (lib/db.js is an in-memory stub until you set this) ---
DATABASE_URL=

# --- Telegram bot ------------------------------------------------
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=saku_puan_bot
TELEGRAM_BOT_TOKEN=
# Any random string. Pass the same value as secret_token when calling setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# --- AI service (your RAG / LLM / ML-prediction backend) ------------
# Leave empty to use the built-in rule-based replies in lib/advisor.js.
AI_SERVICE_URL=
AI_SERVICE_KEY=

# --- Price data (SP2KP Kemendag scraper) -------------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
CRON_SECRET=
